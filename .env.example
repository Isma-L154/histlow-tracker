# Steam HistLow Tracker - environment template
#
# Copy to `.env` for local runs. `.env` is git-ignored and must never be
# committed. In CI every value below is supplied as a GitHub Actions secret.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Steam
# ---------------------------------------------------------------------------

# 17-digit SteamID64 (resolve yours at https://steamid.io).
# The profile's wishlist must be set to Public, otherwise Steam returns an
# empty payload with HTTP 200 and the run would silently find nothing.
STEAM_ID64=

# Storefront region driving BOTH the current Steam price and the ITAD
# historical low. A single consistent country is mandatory: comparing a EUR
# price against a USD low produces constant false positives.
STORE_COUNTRY=ES

# ---------------------------------------------------------------------------
# IsThereAnyDeal
# ---------------------------------------------------------------------------

# Register an application at https://isthereanydeal.com/apps/my/ to obtain a
# key. Verify the account email to lift the rate limit to 1000 req / 5 min.
ITAD_API_KEY=

# ---------------------------------------------------------------------------
# Payload publishing (the bridge to the iOS Shortcut)
# ---------------------------------------------------------------------------

# ID of a SECRET GitHub Gist that acts as the payload drop. The Shortcut
# polls its raw URL. Created once via `scripts/bootstrap_gist.py`.
GIST_ID=

# Fine-grained token carrying the `gist` scope and NOTHING else. Do not reuse
# a broad-scope PAT here: this token is the only credential the workflow can
# leak, so its blast radius is kept to a single gist by construction.
GIST_TOKEN=

# ---------------------------------------------------------------------------
# Behaviour (optional - defaults shown)
# ---------------------------------------------------------------------------

# `INFO` for normal operation, `DEBUG` for troubleshooting. Never logs secrets
# at any level; see `histlow/logging_setup.py`.
LOG_LEVEL=INFO

# When true, run the full pipeline but publish nothing. Useful for a first
# end-to-end verification against real data.
DRY_RUN=false
