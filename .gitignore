# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Runtime state ---------------------------------------------------------
# Regenerated on every run and restored from the Actions cache. It mirrors
# wishlist contents, so it stays out of version control.
var/
*.state.json

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
htmlcov/
.coverage

# --- OS / editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
