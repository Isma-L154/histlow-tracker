# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Runtime state ---------------------------------------------------------
# Regenerated every run and restored from the Actions cache. It mirrors
# wishlist contents, so it stays out of version control.
var/
*.state.json

# --- Web (Cloudflare Worker) ------------------------------------------------
node_modules/
.wrangler/
# Local Worker secrets, the browser-side equivalent of .env.
.dev.vars
.dev.vars.*
# Regenerated from wrangler.jsonc, and a checked-in copy would drift from it.
web/worker-configuration.d.ts

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
htmlcov/
.coverage

# --- OS / editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Local security-scan output
static_analysis_semgrep_*/

# cmd syntax that nothing expanded once created a directory of this literal
# name, and `git add -A` committed a megabyte of Windows icon caches with it.
%SystemDrive%/
