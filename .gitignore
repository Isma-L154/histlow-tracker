# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Runtime state ---------------------------------------------------------
# Regenerated on every run and restored from the Actions cache. It mirrors
# wishlist contents, so it stays out of version control.
var/
*.state.json

# --- Web (Cloudflare Worker) ------------------------------------------------
node_modules/
.wrangler/
# Local Worker secrets, the browser-side equivalent of .env.
.dev.vars
.dev.vars.*
# Regenerated from wrangler.jsonc by `wrangler types`; committing it would
# let the checked-in copy drift from the config it describes.
web/worker-configuration.d.ts

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
htmlcov/
.coverage

# --- OS / editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Local security-scan output
static_analysis_semgrep_*/

# A shell command that writes to %SystemDrive% in cmd syntax, run somewhere
# that does not expand it, creates a directory of that literal name here
# instead of touching the system drive. It happened once and a `git add -A`
# committed a megabyte of Windows icon caches with it.
%SystemDrive%/
