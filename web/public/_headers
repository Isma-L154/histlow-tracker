# Response headers for the whole site, and the only place they are written:
# `src/headers.ts` copies this policy onto the responses the Worker builds.
#
# The CSP is an allowlist. The page loads its own files, images from Steam's and
# IGDB's CDNs (Steam uses several hostnames depending on a game's age), and
# Cloudflare's analytics beacon, which the edge injects.

/*
  Content-Security-Policy: default-src 'none'; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://*.steamstatic.com https://steamcdn-a.akamaihd.net https://media.steampowered.com https://images.igdb.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  # Two years and preload-eligible: without it, a first visit still tries plain HTTP.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
